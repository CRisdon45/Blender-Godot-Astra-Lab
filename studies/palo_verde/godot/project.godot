config_version=5

[application]
config/name="Authored Palo Verde · Desktop"
run/main_scene="res://palo_verde.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1600
window/size/window_height_override=1000
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/fallback_to_opengl3=false
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/16_bits=false
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/ssao/quality=3
environment/ssao/half_size=false
environment/ssil/quality=3
environment/ssil/half_size=false
environment/defaults/default_clear_color=Color(0.64, 0.77, 0.86, 1)
