extends "res://presentation/northstar/canopy/curved_tree.gd"
## Same 64 curved carriers, now with an authored generic spray cutout.
## Mask is original generated coverage only; no color or shadow is baked in.
const CoveragePaint = preload("res://presentation/northstar/canopy/cutout_foliage.gdshader")
const COVERAGE_PNG = ""
static var shared_coverage: Texture2D

func configure(t: Dictionary) -> void:
	super.configure(t)
	if shared_coverage==null:
		var image:=Image.new()
		var error:=image.load_png_from_buffer(Marshalls.base64_to_raw(COVERAGE_PNG))
		if error!=OK:
			push_error("Cannot decode authored canopy coverage")
			return
		image.generate_mipmaps()
		shared_coverage=ImageTexture.create_from_image(image)
	var paint: ShaderMaterial=crown.material_override
	var phase: float=paint.get_shader_parameter("seed_phase")
	paint.shader=CoveragePaint
	paint.set_shader_parameter("height",_height)
	paint.set_shader_parameter("radius",_radius)
	paint.set_shader_parameter("seed_phase",phase)
	paint.set_shader_parameter("coverage_tex",shared_coverage)
	stats["recipe"]="curved-cutout-sprays/4"
	stats["alpha_scissored_foliage"]=true
	stats["mask_width"]=128
