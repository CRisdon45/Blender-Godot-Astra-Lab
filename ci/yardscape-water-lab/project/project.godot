; Minimal Yard-Scape Northstar water look-development project.
; Intentionally no addons, UI framework, plantings, coping, deck, or app systems.

config_version=5

[application]

config/name="Yard-Scape Northstar Water Lab"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

; Fast 4:3 look-development viewport. Promotion/device testing can raise this.
window/size/viewport_width=720
window/size/viewport_height=540
window/size/window_width_override=720
window/size/window_height_override=540

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
