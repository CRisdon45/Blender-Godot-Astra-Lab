; Minimal Yard-Scape Northstar water look-development project.
; Intentionally no addons, UI framework, plantings, coping, deck, or app systems.

config_version=5

[application]

config/name="Yard-Scape Northstar Water Lab"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

; Ultra-fast 4:3 first-look viewport. Promotion/device testing can raise this.
window/size/viewport_width=480
window/size/viewport_height=360
window/size/window_width_override=480
window/size/window_height_override=360

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
